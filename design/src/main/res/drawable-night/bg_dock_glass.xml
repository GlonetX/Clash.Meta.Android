<?xml version="1.0" encoding="utf-8"?>
<!-- Night variant: translucent smoked glass with a dim top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B31C1C1E" />
            <corners android:radius="@dimen/main_dock_corner_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:endColor="#00000000"
                android:startColor="#26FFFFFF" />
            <corners android:radius="@dimen/main_dock_corner_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
            <corners android:radius="@dimen/main_dock_corner_radius" />
        </shape>
    </item>
</layer-list>