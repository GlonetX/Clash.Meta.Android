<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass dock surface: ~70% opaque so scrolling content tints
     through the pill, with a top edge highlight like glass catching
     light. Night variant in drawable-night. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B3FFFFFF" />
            <corners android:radius="@dimen/main_dock_corner_radius_pill" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#66FFFFFF" />
            <corners android:radius="@dimen/main_dock_corner_radius_pill" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="@dimen/main_dock_corner_radius_pill" />
        </shape>
    </item>
</layer-list>