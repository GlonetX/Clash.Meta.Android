<?xml version="1.0" encoding="utf-8"?>
<!--
  One active connection.

  Surface rules from DESIGN_SYSTEM.md apply: this is a *row*, not a card, so it
  sits directly on the window background with no elevation, and the type comes
  from the semantic TextAppearance.App roles rather than Material3 sizes.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="connection"
            type="com.github.kr328.clash.design.model.ConnectionItemDisplay" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/app_row_min_height"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/conn_row_padding_horizontal"
        android:paddingVertical="@dimen/conn_row_padding_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/host_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@{connection.host}"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/network_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_space_sm"
                android:text="@{connection.network}"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <!--
              Close affordance. Same glyph as the toolbar's close-all action, so
              the two never mean different things; the row is the narrower of the
              two contexts and the button keeps the full 48dp touch target.
            -->
            <ImageView
                android:id="@+id/close_view"
                android:layout_width="@dimen/app_icon_container_size"
                android:layout_height="@dimen/app_icon_container_size"
                android:layout_marginStart="@dimen/app_space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/close_connection"
                android:focusable="true"
                android:onClick="@{() -> connection.close()}"
                android:padding="@dimen/app_space_sm"
                android:src="@drawable/ic_baseline_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@{connection.subtitle}"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/traffic_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{connection.traffic}"
                android:textAppearance="@style/TextAppearance.App.MetricSmall" />

            <TextView
                android:id="@+id/duration_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_space_sm"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@{connection.duration}"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>
    </LinearLayout>
</layout>