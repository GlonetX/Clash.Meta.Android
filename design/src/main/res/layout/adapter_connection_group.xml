<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-process section header used when "group by app" is on.

  A header, not a card: it carries `TextAppearance.App.CardTitle` because it is
  the title row of a section, but it keeps the flat list surface so the whole
  screen still reads as one list.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="group"
            type="com.github.kr328.clash.design.model.ConnectionRow.Group" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/app_row_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/conn_row_padding_horizontal"
        android:paddingVertical="@dimen/conn_row_padding_vertical">

        <ImageView
            android:id="@+id/chevron_view"
            android:layout_width="@dimen/app_icon_glyph_size"
            android:layout_height="@dimen/app_icon_glyph_size"
            android:contentDescription="@string/conn_group_toggle"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_baseline_chevron_right" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{group.title}"
                android:textAppearance="@style/TextAppearance.App.CardTitle" />

            <TextView
                android:id="@+id/count_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_xs"
                android:text="@{group.countText}"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_space_sm"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/traffic_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{group.traffic}"
                android:textAppearance="@style/TextAppearance.App.MetricSmall" />

            <TextView
                android:id="@+id/speed_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_xs"
                android:text="@{group.speed}"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>
    </LinearLayout>
</layout>