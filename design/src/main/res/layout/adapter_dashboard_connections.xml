<?xml version="1.0" encoding="utf-8"?>
<!--
  Connections / requests / DNS. All three counts are derived from the rows
  that `QueryConnections()` already returns — there is no separate counter in
  the core, and none is invented here:

    connections = rows.size
    requests    = rows whose metadata Type is HTTP / TLS / QUIC
    dns         = rows whose metadata Type is DNS
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <com.github.kr328.clash.design.view.AppCard
        style="@style/DashboardUnitCard"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/DashboardCardBody">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/DashboardCardIcon"
                    android:src="@drawable/ic_dashboard_connections" />

                <TextView
                    style="@style/DashboardCardTitle"
                    android:text="@string/connections" />
            </LinearLayout>

            <TextView
                android:id="@+id/connections_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/app_space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="bottom"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Metric" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_md"
                android:orientation="horizontal">

                <LinearLayout style="@style/DashboardMiniMetric">

                    <TextView
                        android:id="@+id/requests_value"
                        style="@style/DashboardMiniMetric.Value" />

                    <TextView
                        style="@style/DashboardMiniMetric.Label"
                        android:text="@string/dashboard_requests_count" />
                </LinearLayout>

                <LinearLayout style="@style/DashboardMiniMetric">

                    <TextView
                        android:id="@+id/dns_value"
                        style="@style/DashboardMiniMetric.Value" />

                    <TextView
                        style="@style/DashboardMiniMetric.Label"
                        android:text="@string/dashboard_dns_count" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.github.kr328.clash.design.view.AppCard>
</layout>