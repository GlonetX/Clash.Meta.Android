<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.MainDesign" />

        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <com.github.kr328.clash.design.view.AppCard
        android:layout_width="match_parent"
        android:layout_height="@dimen/dashboard_unit_height"
        android:layout_margin="@dimen/dashboard_cell_margin"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{() -> self.request(Request.OpenProxy)}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/app_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/app_icon_glyph_size_small"
                    android:layout_height="@dimen/app_icon_glyph_size_small"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dashboard_node" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/dashboard_node"
                    android:textAppearance="@style/TextAppearance.App.CardTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/node_name"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/app_space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="bottom"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Metric" />

            <TextView
                android:id="@+id/node_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>
    </com.github.kr328.clash.design.view.AppCard>
</layout>