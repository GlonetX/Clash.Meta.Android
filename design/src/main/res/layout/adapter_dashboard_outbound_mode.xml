<?xml version="1.0" encoding="utf-8"?>
<!--
  Outbound mode. Replaces the MaterialButtonToggleGroup with a sliding
  highlight pill: `mode_highlight` is a plain View drawn behind the three
  labels and translated to the active index. The translation is animated from
  DashboardAdapter so the pill slides instead of jumping.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <com.github.kr328.clash.design.view.AppCard
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dashboard_unit_height"
        android:layout_margin="@dimen/dashboard_cell_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/app_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/outbound_icon"
                    android:layout_width="@dimen/app_icon_glyph_size_small"
                    android:layout_height="@dimen/app_icon_glyph_size_small"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dashboard_outbound"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/outbound_mode"
                    android:textAppearance="@style/TextAppearance.App.CardTitle" />
            </LinearLayout>

            <!-- The pill is positioned by translating it across the track;
                 it must not take part in the labels' weighted layout, so
                 the track is a FrameLayout: highlight behind, labels on
                 top with three equal shares of the full width. -->
            <FrameLayout
                android:id="@+id/mode_stack"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/app_space_md"
                android:background="@drawable/bg_dashboard_track">

                <View
                    android:id="@+id/mode_highlight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dashboard_pill" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mode_rule"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/rule_mode_short"
                        android:textAppearance="@style/TextAppearance.App.NavLabel" />

                    <TextView
                        android:id="@+id/mode_global"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/global_mode_short"
                        android:textAppearance="@style/TextAppearance.App.NavLabel" />

                    <TextView
                        android:id="@+id/mode_direct"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/direct_mode_short"
                        android:textAppearance="@style/TextAppearance.App.NavLabel" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.github.kr328.clash.design.view.AppCard>
</layout>