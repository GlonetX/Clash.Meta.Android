<?xml version="1.0" encoding="utf-8"?>
<!--
  Service availability. The seven streaming probes the latency screen already
  performs, rendered as one swipeable card: a ViewPager of pages plus a dot
  indicator. The service list itself is unchanged — it is owned by
  LatencyActivity and is not duplicated here.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.MainDesign" />

        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <com.github.kr328.clash.design.view.AppCard
        style="@style/DashboardWideCard"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{() -> self.request(Request.OpenLatency)}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/DashboardCardIcon"
                    android:src="@drawable/ic_dashboard_services" />

                <TextView
                    style="@style/DashboardCardTitle"
                    android:text="@string/dashboard_services" />

                <ImageButton
                    android:id="@+id/services_refresh"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dashboard_refresh_services"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_baseline_refresh" />
            </LinearLayout>

            <com.github.kr328.clash.design.view.ServiceStatusPagerView
                android:id="@+id/services_pager"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dashboard_service_pager_height"
                android:layout_marginTop="@dimen/app_space_md" />
        </LinearLayout>
    </com.github.kr328.clash.design.view.AppCard>
</layout>