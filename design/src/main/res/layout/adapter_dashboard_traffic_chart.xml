<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <com.github.kr328.clash.design.view.AppCard
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dashboard_cell_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/app_icon_glyph_size_small"
                    android:layout_height="@dimen/app_icon_glyph_size_small"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_speed"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/dashboard_network_speed"
                    android:textAppearance="@style/TextAppearance.App.CardTitle" />

                <LinearLayout
                    android:id="@+id/window_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/window_one_minute"
                        style="@style/DashboardWindowChip"
                        android:text="@string/dashboard_window_1m" />

                    <TextView
                        android:id="@+id/window_five_minutes"
                        style="@style/DashboardWindowChip"
                        android:text="@string/dashboard_window_5m" />

                    <TextView
                        android:id="@+id/window_thirty_minutes"
                        style="@style/DashboardWindowChip"
                        android:text="@string/dashboard_window_30m" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_md"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_download"
                        android:textAppearance="@style/TextAppearance.App.Label" />

                    <TextView
                        android:id="@+id/speed_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.MetricSmall" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_upload"
                        android:textAppearance="@style/TextAppearance.App.Label" />

                    <TextView
                        android:id="@+id/speed_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.MetricSmall" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chart_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:textAppearance="@style/TextAppearance.App.Label" />
            </LinearLayout>

            <com.github.kr328.clash.design.view.TrafficChartView
                android:id="@+id/traffic_chart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dashboard_chart_height"
                android:layout_marginTop="@dimen/app_space_md" />
        </LinearLayout>
    </com.github.kr328.clash.design.view.AppCard>
</layout>