<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <com.github.kr328.clash.design.view.AppCard style="@style/DashboardUnitCard">

        <LinearLayout style="@style/DashboardCardBody">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/DashboardCardIcon"
                    android:src="@drawable/ic_dashboard_uptime" />

                <TextView
                    style="@style/DashboardCardTitle"
                    android:text="@string/dashboard_uptime" />
            </LinearLayout>

            <TextView
                android:id="@+id/uptime_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/app_space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="bottom"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Metric" />

            <TextView
                android:id="@+id/uptime_since"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_md"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>
    </com.github.kr328.clash.design.view.AppCard>
</layout>