<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="service"
            type="com.github.kr328.clash.design.model.ServiceStatus" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/main_card_content_padding"
        android:paddingVertical="@dimen/item_padding_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{service.name}"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_text_margin"
                android:text="@{service.statusText}"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/latency_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_tailing_margin"
            android:text="@{service.latencyText}"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@{service.statusColor}" />

        <TextView
            android:id="@+id/status_pill_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_tailing_margin"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@{service.statusColorStateList}"
            android:paddingHorizontal="@dimen/status_pill_padding_horizontal"
            android:paddingVertical="@dimen/status_pill_padding_vertical"
            android:text="@{service.pillText}"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</layout>
