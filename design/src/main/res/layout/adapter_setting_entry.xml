<?xml version="1.0" encoding="utf-8"?>
<!--
  A reorderable entry inside the widget / probe-service editors.

  The trailing control is either the three-state size selector (dashboard
  widgets: large / small / hidden) or a plain switch (probe services); the
  editor hides whichever it does not use.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/entry_row_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/app_space_lg"
        android:paddingTop="@dimen/app_space_md"
        android:paddingEnd="@dimen/app_space_lg"
        android:paddingBottom="@dimen/app_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <TextView
                    android:id="@+id/summary_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_space_xs"
                    android:textAppearance="@style/TextAppearance.App.Label" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/size_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_space_md"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/size_large_view"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_widget_size_large" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/size_small_view"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_widget_size_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/size_hidden_view"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_widget_size_hidden" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_space_md"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_xs"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/move_up_view"
                android:layout_width="@dimen/app_icon_container_size"
                android:layout_height="@dimen/app_icon_container_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/move_up"
                android:padding="@dimen/app_space_md"
                android:src="@drawable/ic_baseline_arrow_upward" />

            <ImageButton
                android:id="@+id/move_down_view"
                android:layout_width="@dimen/app_icon_container_size"
                android:layout_height="@dimen/app_icon_container_size"
                android:layout_marginStart="@dimen/app_space_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/move_down"
                android:padding="@dimen/app_space_md"
                android:src="@drawable/ic_baseline_arrow_downward" />
        </LinearLayout>
    </LinearLayout>
</layout>
