<?xml version="1.0" encoding="utf-8"?>
<!--
  Connections page.

  Layout notes:
    * The list is a flat surface (app_elevation_flat) — connection rows are
      rows, not cards.
    * The activity bar is taller than `toolbar_height` because it carries a
      live traffic summary and an optional filter bar, so the list's top
      padding is computed from the measured bar height in ConnectionsDesign
      instead of the fixed `@dimen/toolbar_height` that common_recycler_list
      assumes.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.ConnectionsDesign" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">

        <!--
          Top and bottom padding are applied from ConnectionsDesign: the top has
          to follow the measured height of the activity bar (which grows with
          the summary line and the filter bar), so it cannot be a bound
          resource.
        -->
        <com.github.kr328.clash.design.view.AppRecyclerView
            android:id="@+id/main_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="@dimen/app_space_xl"
            android:text="@string/no_connections"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.github.kr328.clash.design.view.ActivityBarLayout
                android:id="@+id/activity_bar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@{self.surface.insets.top}">

                <LinearLayout
                    android:id="@+id/bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:windowBackground"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/item_tailing_margin">

                        <include
                            layout="@layout/common_activity_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/search_view" />

                        <ImageView
                            android:id="@+id/search_view"
                            android:layout_width="@dimen/item_tailing_component_size"
                            android:layout_height="@dimen/item_tailing_component_size"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/item_tailing_margin"
                            android:layout_toStartOf="@id/sort_view"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/conn_search"
                            android:focusable="true"
                            android:padding="@dimen/toolbar_image_action_padding"
                            android:src="@drawable/ic_baseline_search" />

                        <ImageView
                            android:id="@+id/sort_view"
                            android:layout_width="@dimen/item_tailing_component_size"
                            android:layout_height="@dimen/item_tailing_component_size"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/item_tailing_margin"
                            android:layout_toStartOf="@id/menu_view"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/conn_sort"
                            android:focusable="true"
                            android:padding="@dimen/toolbar_image_action_padding"
                            android:src="@drawable/ic_baseline_swap_vert" />

                        <ImageView
                            android:id="@+id/menu_view"
                            android:layout_width="@dimen/item_tailing_component_size"
                            android:layout_height="@dimen/item_tailing_component_size"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/item_tailing_margin"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/more"
                            android:focusable="true"
                            android:padding="@dimen/toolbar_image_action_padding"
                            android:src="@drawable/ic_baseline_more_vert" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/summary_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="@dimen/conn_row_padding_horizontal"
                        android:paddingEnd="@dimen/conn_row_padding_horizontal"
                        android:paddingBottom="@dimen/app_space_sm"
                        android:textAppearance="@style/TextAppearance.App.MetricSmall" />

                    <LinearLayout
                        android:id="@+id/filter_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/conn_filter_bar_padding"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/conn_row_padding_horizontal">

                            <ImageView
                                android:layout_width="@dimen/app_icon_glyph_size"
                                android:layout_height="@dimen/app_icon_glyph_size"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_baseline_search" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/keyword_view"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/app_space_sm"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/conn_search_hint"
                                android:imeOptions="actionSearch"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textAppearance="@style/TextAppearance.App.Body" />

                            <ImageView
                                android:id="@+id/clear_keyword_view"
                                android:layout_width="@dimen/app_icon_glyph_size"
                                android:layout_height="@dimen/app_icon_glyph_size"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="@string/conn_search_clear"
                                android:focusable="true"
                                android:padding="@dimen/app_space_xs"
                                android:src="@drawable/ic_baseline_close"
                                android:visibility="gone" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/app_space_sm"
                            android:paddingHorizontal="@dimen/conn_row_padding_horizontal"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/protocol_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipSpacingHorizontal="@dimen/app_space_sm"
                                app:singleLine="true"
                                app:singleSelection="true" />
                        </HorizontalScrollView>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/app_space_xs"
                            android:paddingHorizontal="@dimen/conn_row_padding_horizontal"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/process_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipSpacingHorizontal="@dimen/app_space_sm"
                                app:singleLine="true"
                                app:singleSelection="true" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>
            </com.github.kr328.clash.design.view.ActivityBarLayout>

            <View
                android:id="@+id/elevation_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_size"
                android:alpha="0.96"
                android:background="?android:windowBackground"
                android:elevation="@dimen/tab_layout_elevation" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>