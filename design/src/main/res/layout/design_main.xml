<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard page is now a RecyclerView driven by DashboardAdapter. The
  grid itself — column count, span sizes and unit card height — is configured
  in MainDesign from the current width breakpoint; this file only provides the
  header and the container.

  DataBinding expressions were removed from this file on purpose: the state
  now arrives as one immutable DashboardState pushed through the adapter,
  which is what survives view recycling. See DESIGN_SYSTEM.md rule 4.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.MainDesign" />

        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@{self.surface.insets.bottom}">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/dashboard_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/main_top_banner_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/app_space_md"
                android:paddingTop="@{self.surface.insets.top}">

                <FrameLayout
                    android:layout_width="@dimen/large_item_header_layout_size"
                    android:layout_height="@dimen/large_item_header_layout_size">

                    <ImageView
                        android:layout_width="@dimen/main_logo_size"
                        android:layout_height="@dimen/main_logo_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_glonetx_mark" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/application_name"
                    android:textAppearance="@style/TextAppearance.App.ScreenTitle" />

                <ImageView
                    android:id="@+id/edit_cards_view"
                    android:layout_width="@dimen/item_tailing_component_size"
                    android:layout_height="@dimen/item_tailing_component_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/edit_dashboard_cards"
                    android:focusable="true"
                    android:onClick="@{() -> self.request(Request.EditCards)}"
                    android:padding="@dimen/toolbar_image_action_padding"
                    android:src="@drawable/ic_baseline_edit" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pages_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dashboard_page"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/dashboard_padding_horizontal"
                    android:paddingBottom="@dimen/main_dashboard_padding_bottom"
                    android:scrollbars="none" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/AppNavigationBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:backgroundTint="@null"
            android:elevation="0dp"
            app:itemBackground="@null"
            app:itemIconTint="@color/dock_item_icon_color"
            app:itemTextColor="@color/dock_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_main_tabs" />
    </LinearLayout>
</layout>
