<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-connection detail sheet.

  Deliberately a bare container: the field list and the proxy-chain chips are
  built in ConnectionsDesign from `AppRow`, so a connection with no process,
  no rule or no chain renders fewer rows instead of a row of "Unknown" blanks.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.ConnectionsDesign" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/conn_detail_padding">

        <TextView
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.CardTitle" />

        <TextView
            android:id="@+id/subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_xs"
            android:textAppearance="@style/TextAppearance.App.MetricSmall" />

        <HorizontalScrollView
            android:id="@+id/chain_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/conn_detail_padding"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chain_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/detail_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_sm"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/fields_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close_process_view"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/app_space_sm"
                android:layout_weight="1"
                android:onClick="@{() -> self.requestCloseProcessFromSheet()}"
                android:text="@string/conn_detail_close_process" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="@{() -> self.requestCloseFromSheet()}"
                android:text="@string/conn_detail_close" />
        </LinearLayout>
    </LinearLayout>
</layout>