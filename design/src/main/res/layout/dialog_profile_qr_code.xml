<?xml version="1.0" encoding="utf-8"?>
<!--
  QR sharing.

  The dialog rendered the code and offered exactly one action (share the
  bitmap). A subscription link is more useful as text than as a picture, so the
  dialog also carries the two actions that actually move it: hand the URL to
  another app, or put it on the clipboard.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dialog_padding">

            <ImageView
                android:id="@+id/qr_code"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@android:color/white"
                android:contentDescription="@string/share_qr_code"
                android:forceDarkAllowed="false"
                android:scaleType="fitCenter" />

            <com.github.kr328.clash.design.view.AppRow
                android:id="@+id/share_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_md"
                app:icon="@drawable/ic_baseline_publish"
                app:subtext="@string/profiles_share_via"
                app:text="@string/profiles_share" />

            <com.github.kr328.clash.design.view.AppRow
                android:id="@+id/copy_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_content_copy"
                app:subtext="@string/profiles_copy_link_summary"
                app:text="@string/profiles_copy_link" />
        </LinearLayout>
    </ScrollView>
</layout>
