<?xml version="1.0" encoding="utf-8"?>
<!--
  Profiles page settings dialog (dynamic colors / update on launch).
  Plain layout without DataBinding: ProfilesActivity wires the switches
  by id, because the handlers need app-module classes (ApplicationObserver)
  that the design module cannot reference.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/app_space_xl">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_dynamic_colors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/app_row_min_height"
        android:text="@string/dynamic_colors"
        android:textAppearance="@style/TextAppearance.App.Body" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_update_on_launch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_space_md"
        android:minHeight="@dimen/app_row_min_height"
        android:text="@string/update_profiles_on_launch"
        android:textAppearance="@style/TextAppearance.App.Body" />
</LinearLayout>
