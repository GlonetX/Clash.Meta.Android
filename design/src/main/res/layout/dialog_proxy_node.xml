<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-node action sheet (long-press a node card).

  The node "host" (server address) and traffic totals are not part of the
  Proxy model the core exposes, so this sheet deliberately shows only what
  the group data carries: names, type and delay. Testing a single node is
  not possible without a new request type, which the activity-owned request
  dispatcher does not support — see ProxyDesign.Request.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.ProxyDesign" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/app_space_lg">

        <TextView
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.CardTitle" />

        <TextView
            android:id="@+id/subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_xs"
            android:textAppearance="@style/TextAppearance.App.MetricSmall" />

        <LinearLayout
            android:id="@+id/fields_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_sm"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_name_view"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_md"
            android:onClick="@{() -> self.requestCopyNodeName()}"
            android:text="@string/proxy_node_copy_name" />
    </LinearLayout>
</layout>
