    <item android:title="@string/filter">
        <menu>
            <item
                android:id="@+id/not_selectable"
                android:checkable="true"
                android:title="@string/not_selectable" />
        </menu>
    </item>
    <item android:title="@string/mode">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/dont_modify"
                    android:title="@string/dont_modify" />
                <item
                    android:id="@+id/direct_mode"
                    android:title="@string/direct_mode" />
                <item
                    android:id="@+id/global_mode"
                    android:title="@string/global_mode" />
                <item
                    android:id="@+id/rule_mode"
                    android:title="@string/rule_mode" />
            </group>
        </menu>
    </item>
    <item android:title="@string/layout">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/single"
                    android:title="@string/single" />
                <item
                    android:id="@+id/doubles"
                    android:title="@string/doubles" />
                <item
                    android:id="@+id/multiple"
                    android:title="@string/multiple" />

            </group>
        </menu>
    </item>
    <!--
      Card density and node icon are layout options, not filters: they change
      how a card is drawn and never change which nodes the core returns, so they
      do not trigger a reload — only a re-layout.
    -->
    <item android:title="@string/proxy_card_density">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/density_tight"
                    android:title="@string/proxy_density_tight" />
                <item
                    android:id="@+id/density_standard"
                    android:title="@string/proxy_density_standard" />
                <item
                    android:id="@+id/density_loose"
                    android:title="@string/proxy_density_loose" />
            </group>
        </menu>
    </item>
    <item android:title="@string/proxy_node_icon">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/icon_none"
                    android:title="@string/proxy_node_icon_none" />
                <item
                    android:id="@+id/icon_flag"
                    android:title="@string/proxy_node_icon_flag" />
            </group>
        </menu>
    </item>
    <item android:title="@string/sort">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/default_"
                    android:title="@string/default_" />
                <item
                    android:id="@+id/name"
                    android:title="@string/name" />
                <item
                    android:id="@+id/delay"
                    android:title="@string/delay" />
            </group>
        </menu>
    </item>
</menu>