<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeOverlay" />

    <style name="ThemeOverlay.ControlColorError">
        <item name="colorControlNormal">@color/color_error</item>
        <item name="android:textColor">@color/color_error</item>
    </style>

    <style name="AppNavigationBar" />

    <style name="AppNavigationBar.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:shapeAppearanceOverlay">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>