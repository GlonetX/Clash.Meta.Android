    <!-- ==================== Dynamic colour overlays ====================
         Applied by MainApplication from onActivityCreated (AFTER
         BaseActivity.applyDayNight force-applies the AppTheme* family, and
         BEFORE the first view inflation), because Material's own
         DynamicColors hook applies its overlay in onActivityPreCreated —
         before onCreate — where applyDayNight would overwrite it.

         Uses the public material_dynamic_* palette (the m3_sys_color_*
         tokens are library-private). Surface neutrals use the standard
         tonal steps (neutral99 / neutral10) instead of the library's
         extended steps (neutral_variant98 / neutral_variant6), which are
         not publicly exported; both are visually equivalent.
         -->

    /** Marks a row as destructive (e.g. the delete action in a menu).
     *  Overrides the colour roles that AppRow and the App text
     *  appearances actually resolve (colorOnSurface for text,
     *  colorOnSurfaceVariant for the icon), following ?attr/colorError
     *  so it adapts to dark themes. */
    <style name="ThemeOverlay.App.DestructiveRow" parent="">
        <item name="colorOnSurface">?attr/colorError</item>
        <item name="colorOnSurfaceVariant">?attr/colorError</item>
        <item name="colorGroupIconBackground">?attr/colorErrorContainer</item>
    </style>

    <!-- Re-asserts the AMOLED surfaces after the dynamic overlay. -->
    <style name="ThemeOverlay.App.PureBlack" parent="">
        <item name="android:colorBackground">@color/color_black_background</item>
        <item name="android:windowBackground">@color/color_black_background</item>
        <item name="colorSurface">@color/color_black_surface</item>
        <item name="colorSurfaceVariant">@color/color_black_surface_variant</item>
    </style>
</resources>
